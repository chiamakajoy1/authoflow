// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// 1. This generates the modern Prisma client into your project files
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// 2. This connects explicitly to your local MySQL machine
datasource db {
  provider = "mysql"
}

// ==========================================
// 3. Health Insurance Filing Cabinet Tables
// ==========================================

enum RequestType {
  PRE_AUTH
  CLAIMS
  REFERRAL
  PRESCRIPTION
}

enum RequestStatus {
  PENDING
  AI_REVIEWED
  APPROVED
  DENIED
  ESCALATED
}

model ApprovalRequest {
  id                  String               @id @default(uuid())
  type                RequestType
  status              RequestStatus        @default(PENDING)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  preAuthDetails      PreAuthDetails?
  prescriptionDetails PrescriptionDetails?
}

model PreAuthDetails {
  id            String          @id @default(uuid())
  requestId     String          @unique
  request       ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  procedureCode String          
  icd10Codes    String          // Stored as a comma-separated text string for MySQL compatibility
  facility      String          
  scheduledDate DateTime
}

model PrescriptionDetails {
  id        String          @id @default(uuid())
  requestId String          @unique
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  drugName  String          
  ndcCode   String          
  dosage    String          
  quantity  Int             
}
